# =============================================================================
# F-Droid Repo Configuration
# Copy this file to .env and fill in your values.
# This single file drives both config.yml and rclone.conf generation.
# =============================================================================

# -- Repo Identity ------------------------------------------------------------
REPO_NAME="F-Droid Repository"
REPO_DESCRIPTION="Apps distributed via F-Droid."
REPO_URL="https://repo.fdroid.local/fdroid/repo"
REPO_WEB_BASE_URL="https://repo.fdroid.local/packages/"

# -- Signing -------------------------------------------------------------------
# Set to "true" to sign the repo index (default). Set to "false" for unsigned.
# Changing this value requires running: ./scripts/clean.sh && ./scripts/init.sh
REPO_SIGNED="true"
KEYSTORE_FILE="keystore.p12"
REPO_KEYALIAS="keystore.local"
KEYSTORE_PASS=""
KEY_PASS=""
KEYDNAME="CN=keystore.local, OU=F-Droid"

# -- S3 / rclone ---------------------------------------------------------------
S3_REMOTE_NAME="fdroid-repo"
S3_PROVIDER="Cloudflare"
S3_BUCKET="fdroid-repo"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_ENDPOINT=""
